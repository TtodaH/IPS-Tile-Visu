{
    "elements": [
        {
            "type": "Label",
            "caption": "Fußbodenheizung Kachel – kompakte Kachel-Visualisierung für einen Heizkreis (Raumtemperatur, Sollwert, Basissollwert, Stellgröße). Der Sollwert ist einstellbar; der Basissollwert bleibt schreibgeschuetzt."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Variablen des Heizkreises",
            "expanded": true,
            "items": [
                {
                    "type": "SelectVariable",
